# Environment Configuration Template
# Copy this file to .env and configure your values

# MongoDB Atlas URI (Keep private! Do NOT commit your actual .env)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/
DB_NAME=traffic_management_db

# Flask Server Config
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
DEBUG=False
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production

# JWT Authentication Config
JWT_SECRET_KEY=replace_with_jwt_secret_key
JWT_EXPIRATION_HOURS=12

# Video Source Settings (Modes: SIMULATION, UPLOAD, WEBCAM, RTSP)
DEFAULT_VIDEO_SOURCE=SIMULATION
RTSP_STREAM_URL=

# Evidence & Storage
MAX_EVIDENCE_STORAGE_MB=500
EVIDENCE_RETENTION_DAYS=30
